# Configuration Nginx pour un VPS (Ubuntu/Debian, PHP-FPM 8.3+).
# Copier dans /etc/nginx/sites-available/intellino, adapter le domaine, le chemin et la version de PHP,
# puis : ln -s /etc/nginx/sites-available/intellino /etc/nginx/sites-enabled/ && nginx -t && systemctl reload nginx
# Certificat HTTPS gratuit ensuite : certbot --nginx -d votre-domaine.com -d www.votre-domaine.com

server {
    listen 80;
    listen [::]:80;
    server_name votre-domaine.com www.votre-domaine.com;

    # La racine DOIT être le dossier public/ du projet.
    root /var/www/intellino-site/public;
    index index.php;

    charset utf-8;
    client_max_body_size 10M;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Fichiers générés par Vite : mise en cache longue (leurs noms changent à chaque build).
    location /build/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location = /favicon.ico { access_log off; log_not_found off; }

    error_page 404 /index.php;

    location ~ ^/index\.php(/|$) {
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    # Bloque les fichiers cachés (.env, .git…).
    location ~ /\.(?!well-known).* {
        deny all;
    }
}
