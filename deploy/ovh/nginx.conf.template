# Modèle Nginx utilisé par deploy/ovh/setup-server.sh (les marqueurs __…__ sont remplacés automatiquement).
# Certbot ajoute ensuite les blocs HTTPS et la redirection HTTP → HTTPS.

# ─── Front React (SPA) : __SERVER_NAMES__ ───────────
server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAMES__;

    root __APP_DIR__/frontend-ui/dist;
    index index.html;
    charset utf-8;

    # Toutes les adresses (/produits/…, /admin/…) renvoient vers index.html : React Router gère la navigation.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Fichiers compilés : noms uniques à chaque build → cache long.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # index.html jamais mis en cache : une mise à jour est visible immédiatement.
    # (un add_header dans un bloc location annule ceux du serveur : les en-têtes de sécurité sont donc répétés)
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        __ROBOTS_HEADER__
    }

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    __ROBOTS_HEADER__

    location ~ /\.(?!well-known).* {
        deny all;
    }
}

# ─── API Laravel : __API_DOMAIN__ ───────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name __API_DOMAIN__;

    # La racine DOIT être le dossier public/ du backend (le reste du code n'est jamais exposé).
    root __APP_DIR__/backend/public;
    index index.php;
    charset utf-8;
    client_max_body_size 10M; # envoi du logo / de l'image d'accueil depuis l'admin
    __ROBOTS_HEADER__

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Images envoyées depuis l'admin : cache d'une semaine.
    location /images/uploads/ {
        expires 7d;
        access_log off;
    }

    gzip on;
    gzip_types application/json application/xml text/plain;

    error_page 404 /index.php;

    location ~ ^/index\.php(/|$) {
        fastcgi_pass unix:__PHP_SOCK__;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_hide_header X-Powered-By;
    }

    # Aucun autre fichier PHP exécutable.
    location ~ \.php$ {
        return 404;
    }

    location ~ /\.(?!well-known).* {
        deny all;
    }
}
