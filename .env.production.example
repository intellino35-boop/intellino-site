# ─────────────────────────────────────────────────────────────
#  IntellIno — configuration de PRODUCTION
#  Copier ce fichier en ".env" sur le serveur, puis compléter les valeurs.
#  Ne jamais publier le fichier .env (il contient des mots de passe).
# ─────────────────────────────────────────────────────────────

APP_NAME=IntellIno
APP_ENV=production
# Générer avec : php artisan key:generate
APP_KEY=
APP_DEBUG=false
# Votre domaine, en https, sans « / » final
APP_URL=https://www.votre-domaine.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# Base MySQL fournie par l'hébergeur
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies envoyés uniquement en HTTPS
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Envoi d'e-mails (identifiants SMTP fournis par l'hébergeur ou votre messagerie)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@votre-domaine.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Derrière Cloudflare ou un répartiteur de charge : TRUSTED_PROXIES=*
TRUSTED_PROXIES=

# ── Site IntellIno ──
INTELLINO_EMAIL=contact@intellino.tech
INTELLINO_PHONE=
INTELLINO_WHATSAPP=
INTELLINO_LOCATION=Afrique
# Reçoit une copie de chaque message du formulaire de contact (vide = désactivé)
INTELLINO_NOTIFY_EMAIL=
# Logo et image d'accueil : vide = fichiers fournis (public/images/logo.png et hero.jpg)
INTELLINO_LOGO=
INTELLINO_HERO_IMAGE=

# ── Informations légales (un champ vide s'affiche « [À compléter] ») ──
LEGAL_COMPANY=IntellIno
LEGAL_FORM=
LEGAL_CAPITAL=
LEGAL_REGISTRATION=
LEGAL_ADDRESS=
LEGAL_COUNTRY=
LEGAL_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_PRIVACY_EMAIL=
LEGAL_RETENTION_MONTHS=
LEGAL_LAW=
LEGAL_UPDATED_AT=2026-09-24
